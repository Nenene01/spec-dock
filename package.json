{
  "name": "spec-dock",
  "version": "0.1.0",
  "private": true,
  "description": "Source-anchored specifications for Prisma, Zod, OpenAPI, and Markdown.",
  "type": "module",
  "bin": {
    "specdock": "./cli/src/index.mjs"
  },
  "scripts": {
    "specdock": "node ./cli/src/index.mjs",
    "scan": "node ./cli/src/index.mjs scan",
    "check": "node ./cli/src/index.mjs check",
    "build": "node ./cli/src/index.mjs build",
    "studio": "node ./cli/src/index.mjs serve",
    "dev": "node ./cli/src/index.mjs dev",
    "test": "node --test",
    "governance:check": "node ./scripts/governance-check.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "license": "MIT",
  "dependencies": {
    "@apidevtools/swagger-parser": "^13.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.3.1"
  }
}
