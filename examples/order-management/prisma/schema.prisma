datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

/// 注文を行う顧客。
model Customer {
  /// 顧客ID。
  id     String  @id @default(uuid())
  /// 表示名。
  name   String
  /// 顧客が行った注文。
  orders Order[]
  @@index([name], map: "customer_name_idx")
}

/// 顧客が行う注文。
model Order {
  /// 注文ID。
  id         String   @id @default(uuid())
  /// 利用者が確認できる一意な注文番号。
  orderNo    String   @unique
  /// 顧客ID。
  customerId String
  /// 注文者。
  customer   Customer @relation(fields: [customerId], references: [id])
  /// 作成日時。
  createdAt  DateTime @default(now())
  /// 注文明細。
  items      OrderItem[]
  @@index([customerId, createdAt], map: "order_customer_created_idx")
}

/// 注文可能な商品。
model Product {
  /// 商品ID。
  id          String      @id @default(uuid())
  /// 商品名。
  name        String
  /// 現在の単価（円）。
  unitPrice   Int         @default(0)
  /// 注文可能かどうか。
  isActive    Boolean     @default(true)
  /// この商品を含む注文明細。
  orderItems  OrderItem[]
  @@index([isActive], map: "product_active_idx")
}

/// 注文に含まれる商品明細。
model OrderItem {
  /// 注文明細ID。
  id         String  @id @default(uuid())
  /// 注文ID。
  orderId    String
  /// 商品ID。
  productId  String
  /// 注文数量。
  quantity   Int
  /// 注文時点の単価。
  unitPrice  Int
  order      Order   @relation(fields: [orderId], references: [id])
  product    Product @relation(fields: [productId], references: [id])
  @@unique([orderId, productId], map: "order_item_order_product_unique")
}
